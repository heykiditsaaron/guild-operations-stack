FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src
COPY sql ./sql
RUN npm run build

FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    GUILD_OPERATIONS_ADMIN_DATA_DIR=/var/lib/guild-operations-administration \
    GUILD_OPERATIONS_ADMIN_BIND_HOST=0.0.0.0
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
VOLUME ["/var/lib/guild-operations-administration"]
EXPOSE 3103
CMD ["node", "dist/system-administration/server.js"]
