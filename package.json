{
  "name": "guild-operations-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/prepare-build.mjs && tsc -p tsconfig.json && mkdir -p dist/web/public && cp -R src/web/public/. dist/web/public/",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "guild:sync": "tsx src/sync-guild.ts",
    "guild:enrich": "tsx src/enrich-guild-characters.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:boundaries": "node scripts/check-raffle-application-boundary.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "dotenv": "^17.2.1",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "ws": "^8.18.3",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "@types/ws": "^8.18.1"
  }
}
