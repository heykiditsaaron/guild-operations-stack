# Optional: override the host port published by Docker Compose.
HTTP_PORT=3100

# Select the image version used by all deployment services and ./go.
# Defaults to latest when unset. For a development deployment, use dev.
# GUILD_OPERATIONS_VERSION=dev

# Advanced deployment: override the PostgreSQL connection used by all app processes.
# The packaged Compose deployment supplies the bundled PostgreSQL address by default.
# DATABASE_URL=postgresql://user:password@postgres.example.net:5432/guild_operations
