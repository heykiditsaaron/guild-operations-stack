# Guild Operations — host configuration
# Copy to .env, fill in the required values, and protect it: chmod 600 .env
# Keep .env out of version control. Do not share credentials in support logs.

# === Installation and network ===
# Required: externally reachable origin (scheme, host, optional port; no path).
PUBLIC_ORIGIN=https://guild.example.com
# Optional: published host port (default: 3000).
HTTP_PORT=3000

# === Blizzard application (required for guild initialization/sign-in) ===
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# === PostgreSQL (choose one deployment topology) ===
# NEW bundled PostgreSQL: set a strong URL-safe password here before first start.
# Generate a suitable value with: openssl rand -hex 32
# Compose uses this value for both PostgreSQL initialization and the app URL.
# Do not change it on an existing database without a coordinated credential migration.
POSTGRES_PASSWORD=
# External PostgreSQL: use compose.external-db.yaml and set DATABASE_URL.
# Bundled PostgreSQL: leave DATABASE_URL unset unless you deliberately override it.
# DATABASE_URL=postgresql://user:password@database-host:5432/guild_operations

# === Discord application (optional integration) ===
# When enabled, supply all three values for the same Discord application.
# DISCORD_APPLICATION_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=

# === Operations (optional) ===
# Defaults to latest. Pin a release for stable deployments; dev is for testing.
# GUILD_OPERATIONS_VERSION=latest
# Defaults to info.
# LOG_LEVEL=info

# === Optional protected credential files ===
# The primary configuration is this .env file. For selected credentials, existing
# Compose overlays can mount files instead; explicitly configured *_FILE values
# take precedence over corresponding direct environment values. Missing/empty
# selected files fail instead of falling back to .env.
# compose.database-secret.yaml: secrets/database-url
# compose.blizzard-secret.yaml: secrets/blizzard-client-id,
#   secrets/blizzard-client-secret
# compose.discord-secret.yaml: secrets/discord-application-id,
#   secrets/discord-client-secret, secrets/discord-bot-token
# compose.bundled-db-secret.yaml: NEW bundled installations only; run
#   sh scripts/init-bundled-db-secrets.sh and preserve its generated files.
# Select Compose overlays explicitly; .env does not automatically mount files.
