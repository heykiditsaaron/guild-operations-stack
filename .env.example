# Optional: override the host port published by Docker Compose.
HTTP_PORT=3000

# Select the image version used by all deployment services and ./go.
# Defaults to latest when unset. For a development deployment, use dev.
# GUILD_OPERATIONS_VERSION=dev

# Transitional database configuration:
# DATABASE_URL can override the application's PostgreSQL connection string.
# For a protected file instead, use compose.database-secret.yaml and place
# the PostgreSQL URL in ./secrets/database-url (ignored by Git).
# The bundled database service is still started by compose.yaml; external
# PostgreSQL topology and credential provisioning are not implemented yet.

# Host-owned public URL used for Blizzard OAuth callbacks.
# PUBLIC_ORIGIN=https://guild.example.com

# Blizzard application credentials belong to the host, not Guild Settings.
# BLIZZARD_CLIENT_ID=your-client-id
# BLIZZARD_CLIENT_SECRET=configure-on-host

# For protected Blizzard credential files, use compose.blizzard-secret.yaml.
# Place the two values in ./secrets/blizzard-client-id and
# ./secrets/blizzard-client-secret; do not set direct values at the same time.

# Discord application credentials are provisioned by the host.
# DISCORD_APPLICATION_ID=your-discord-application-id
# DISCORD_CLIENT_SECRET=configure-on-host
# DISCORD_BOT_TOKEN=configure-on-host
# Alternatively, use compose.discord-secret.yaml with files under ./secrets/.
